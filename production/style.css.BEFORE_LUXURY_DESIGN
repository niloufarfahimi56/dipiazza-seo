:root {
    --bg: #f7f5f1;
    --text: #1d1d1b;
    --muted: #68645e;
    --accent: #9a7b4f;
    --white: #ffffff;
    --border: #ded9d0;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
}

header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
}

nav {
    max-width: 1200px;
    margin: auto;
    padding: 18px 24px;
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
}

nav a {
    color: var(--text);
    text-decoration: none;
    margin-left: 16px;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 70px 24px;
}

.hero {
    min-height: 520px;
    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 800px;
}

h1 {
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    margin-bottom: 24px;
}

h2 {
    font-size: 32px;
    margin-top: 60px;
}

h3 {
    font-size: 22px;
}

p {
    max-width: 760px;
    color: var(--muted);
}

.button {
    display: inline-block;
    margin-top: 20px;
    padding: 13px 24px;
    background: var(--text);
    color: white;
    text-decoration: none;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 30px;
}

.card {
    background: var(--white);
    padding: 28px;
    border: 1px solid var(--border);
}

footer {
    margin-top: 80px;
    padding: 50px 24px;
    background: var(--text);
    color: white;
}

footer a {
    color: white;
}

@media (max-width: 700px) {
    nav {
        flex-direction: column;
        align-items: flex-start;
    }

    nav a {
        margin-left: 0;
        margin-right: 12px;
    }

    .container {
        padding: 45px 18px;
    }
}
